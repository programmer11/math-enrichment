# --- Local development (matches docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://app_user:app_password@localhost:5432/math_assessment

# --- Production (free tier, up to ~50k users) ---
# See README.md > "Choosing a free production database" for the full
# rationale. Neon (https://neon.tech) is a real Postgres instance, so
# this Just Works with zero code changes -- only the URL changes.
#
# 1. Create a free Neon project (no credit card required).
# 2. Copy the connection string it gives you and adapt it to this form
#    (note the driver prefix `+psycopg` and `sslmode=require`, which
#    Neon requires):
#
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<endpoint>.neon.tech/<dbname>?sslmode=require
#
# 3. Prefer the "pooled" connection string Neon shows you (the endpoint
#    with "-pooler" in the hostname) over the direct one -- it routes
#    through PgBouncer, which matters once you have more than a handful
#    of concurrent requests, since Neon's compute has a fixed max
#    connection count.
